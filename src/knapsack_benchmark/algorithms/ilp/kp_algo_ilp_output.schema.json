{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "entry": {
    "type": "object",
    "additionalProperties": false,
    "required": [
      "id",
      "label",
      "description",
      "short_label",
      "exact",
      "reference",
      "config"
    ],
    "properties": {
      "id": {
        "enum": [
          "ilp"
        ]
      },
      "label": {
        "type": "string"
      },
      "description": {
        "type": "string"
      },
      "short_label": {
        "type": "string"
      },
      "exact": {
        "type": "boolean"
      },
      "reference": {
        "type": "boolean"
      },
      "config": {
        "type": "object"
      }
    }
  },
  "config": {
    "type": "object",
    "additionalProperties": false,
    "required": [
      "repeats"
    ],
    "properties": {
      "repeats": {
        "type": "integer",
        "minimum": 1
      }
    }
  },
  "details": {
    "type": "object",
    "additionalProperties": false,
    "required": [
      "solver",
      "status"
    ],
    "properties": {
      "solver": {
        "enum": [
          "intlinprog",
          "glpk",
          "scipy.optimize.milp (HiGHS)"
        ]
      },
      "status": {
        "type": [
          "integer",
          "null"
        ]
      },
      "mip_gap": {
        "type": [
          "number",
          "null"
        ]
      }
    }
  }
}
