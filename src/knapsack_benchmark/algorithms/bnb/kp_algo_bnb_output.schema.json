{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "entry": {
    "type": "object",
    "additionalProperties": false,
    "required": [
      "id",
      "label",
      "description",
      "short_label",
      "exact",
      "reference",
      "config"
    ],
    "properties": {
      "id": {
        "enum": [
          "bnb"
        ]
      },
      "label": {
        "type": "string"
      },
      "description": {
        "type": "string"
      },
      "short_label": {
        "type": "string"
      },
      "exact": {
        "type": "boolean"
      },
      "reference": {
        "type": "boolean"
      },
      "config": {
        "type": "object"
      }
    }
  },
  "config": {
    "type": "object",
    "additionalProperties": false,
    "required": [
      "max_nodes",
      "repeats"
    ],
    "properties": {
      "max_nodes": {
        "type": "integer",
        "minimum": 1
      },
      "repeats": {
        "type": "integer",
        "minimum": 1
      }
    }
  },
  "details": {
    "type": "object",
    "additionalProperties": false,
    "required": [
      "nodes",
      "node_limit",
      "node_limit_reached"
    ],
    "properties": {
      "nodes": {
        "type": "integer",
        "minimum": 0
      },
      "node_limit": {
        "type": "integer",
        "minimum": 1
      },
      "node_limit_reached": {
        "type": "boolean"
      }
    }
  }
}
