{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "entry": {
    "type": "object",
    "additionalProperties": false,
    "required": [
      "id",
      "label",
      "description",
      "short_label",
      "exact",
      "reference",
      "config"
    ],
    "properties": {
      "id": {
        "enum": [
          "ga"
        ]
      },
      "label": {
        "type": "string"
      },
      "description": {
        "type": "string"
      },
      "short_label": {
        "type": "string"
      },
      "exact": {
        "type": "boolean"
      },
      "reference": {
        "type": "boolean"
      },
      "config": {
        "type": "object"
      }
    }
  },
  "config": {
    "type": "object",
    "additionalProperties": false,
    "required": [
      "pop_size",
      "generations",
      "tournament",
      "crossover_rate",
      "mutation_factor",
      "repeats"
    ],
    "properties": {
      "pop_size": {
        "type": "integer",
        "minimum": 2
      },
      "generations": {
        "type": "integer",
        "minimum": 0
      },
      "tournament": {
        "type": "integer",
        "minimum": 1
      },
      "crossover_rate": {
        "type": "number",
        "minimum": 0
      },
      "mutation_factor": {
        "type": "number",
        "minimum": 0
      },
      "repeats": {
        "type": "integer",
        "minimum": 1
      }
    }
  },
  "details": {
    "type": "object",
    "additionalProperties": false,
    "required": [
      "evaluations",
      "generations"
    ],
    "properties": {
      "evaluations": {
        "type": "integer",
        "minimum": 0
      },
      "generations": {
        "type": "integer",
        "minimum": 0
      }
    }
  }
}
