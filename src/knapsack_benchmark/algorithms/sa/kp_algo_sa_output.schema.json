{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "entry": {
    "type": "object",
    "additionalProperties": false,
    "required": [
      "id",
      "label",
      "description",
      "short_label",
      "exact",
      "reference",
      "config"
    ],
    "properties": {
      "id": {
        "enum": [
          "sa"
        ]
      },
      "label": {
        "type": "string"
      },
      "description": {
        "type": "string"
      },
      "short_label": {
        "type": "string"
      },
      "exact": {
        "type": "boolean"
      },
      "reference": {
        "type": "boolean"
      },
      "config": {
        "type": "object"
      }
    }
  },
  "config": {
    "type": "object",
    "additionalProperties": false,
    "required": [
      "penalty",
      "restarts",
      "steps_factor",
      "t0_factor",
      "t_end_factor",
      "repeats"
    ],
    "properties": {
      "penalty": {
        "type": [
          "string",
          "number"
        ]
      },
      "restarts": {
        "type": "integer",
        "minimum": 1
      },
      "steps_factor": {
        "type": "number",
        "minimum": 0
      },
      "t0_factor": {
        "type": "number",
        "minimum": 0
      },
      "t_end_factor": {
        "type": "number",
        "minimum": 0
      },
      "repeats": {
        "type": "integer",
        "minimum": 1
      }
    }
  },
  "details": {
    "type": "object",
    "additionalProperties": false,
    "required": [
      "penalty",
      "proposals",
      "accepted",
      "t_start",
      "t_end"
    ],
    "properties": {
      "penalty": {
        "type": "number"
      },
      "proposals": {
        "type": "integer",
        "minimum": 0
      },
      "accepted": {
        "type": "integer",
        "minimum": 0
      },
      "t_start": {
        "type": "number"
      },
      "t_end": {
        "type": "number"
      }
    }
  }
}
